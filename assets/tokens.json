{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/archoera-ui/tokens.json",
  "name": "archoera-ui",
  "version": "1.0.0",
  "description": "ArchoeraCX UI design tokens: flat beveled surfaces, hairline structure, token-driven themes, restrained motion.",
  "color": {
    "light": {
      "accent": "#4F7CFF",
      "accentHover": "#6B90FF",
      "accentPressed": "#3D66E0",
      "accentSoft": "#4F7CFF1F",
      "onAccent": "#FFFFFF",
      "bg": "#F7F8FB",
      "surface1": "#FFFFFF",
      "surface2": "#F1F3F8",
      "surface3": "#E8EBF3",
      "textPrimary": "#111827",
      "textSecondary": "#4B5563",
      "textTertiary": "#8A94A6",
      "danger": "#D64545",
      "success": "#2F9E6B",
      "warning": "#B7791F",
      "border": "#E3E7EF",
      "borderStrong": "#CFD6E4",
      "overlay": "#00000066"
    },
    "dark": {
      "accent": "#7A9BFF",
      "accentHover": "#94AEFF",
      "accentPressed": "#5F82E6",
      "accentSoft": "#7A9BFF26",
      "onAccent": "#0B1020",
      "bg": "#10141B",
      "surface1": "#171D26",
      "surface2": "#1E2632",
      "surface3": "#27313F",
      "textPrimary": "#F2F5FA",
      "textSecondary": "#AAB5C6",
      "textTertiary": "#738094",
      "danger": "#FF7A7A",
      "success": "#54D39A",
      "warning": "#F0B45A",
      "border": "#2A3442",
      "borderStrong": "#3A4759",
      "overlay": "#000000A6"
    },
    "brandAccent": "#4F7CFF"
  },
  "typography": {
    "fontSans": "Noto Sans SC, Source Han Sans SC, system-ui, sans-serif",
    "fontMono": "JetBrains Mono, ui-monospace, SFMono-Regular, monospace",
    "defaultWeight": 500,
    "scale": {
      "display": { "size": 32, "lineHeight": 40, "weight": 500, "letterSpacing": -0.8 },
      "title1": { "size": 24, "lineHeight": 32, "weight": 500, "letterSpacing": -0.4 },
      "title2": { "size": 18, "lineHeight": 26, "weight": 500, "letterSpacing": 0 },
      "body": { "size": 14, "lineHeight": 22, "weight": 500, "letterSpacing": 0 },
      "bodyStrong": { "size": 14, "lineHeight": 22, "weight": 600, "letterSpacing": 0 },
      "caption": { "size": 12, "lineHeight": 18, "weight": 500, "letterSpacing": 0 },
      "overline": { "size": 11, "lineHeight": 16, "weight": 600, "letterSpacing": 0.6 }
    }
  },
  "spacing": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "xxxl": 64
  },
  "radius": {
    "s": 2,
    "m": 4,
    "l": 4,
    "xl": 6,
    "full": 999
  },
  "bevel": {
    "s": 8,
    "m": 14,
    "l": 22,
    "panel": { "topRight": "l", "bottomLeft": "s" },
    "dialog": { "topLeft": "l", "bottomRight": "s" },
    "toast": { "topRight": "s", "bottomLeft": "s" }
  },
  "border": {
    "width": 1,
    "strongWidth": 1,
    "selectionWidth": 2
  },
  "elevation": {
    "light": "0 8px 24px rgba(17, 24, 39, 0.08)",
    "dark": "0 8px 24px rgba(0, 0, 0, 0.35)",
    "note": "Overlays only (menu, dialog, toast, drawer). Page sections and panels never use shadows."
  },
  "motion": {
    "fast": 120,
    "normal": 180,
    "slow": 240,
    "pageTransition": 320,
    "hoverGlowIn": 160,
    "hoverGlowOut": 220,
    "progressSweep": 1400,
    "skeletonPulse": 1100,
    "curves": {
      "out": "cubic-bezier(0.215, 0.61, 0.355, 1)",
      "in": "cubic-bezier(0.55, 0.055, 0.675, 0.19)"
    },
    "distance": { "content": 8, "toast": 10, "lift": "2%" }
  },
  "layout": {
    "titleBarHeight": 48,
    "commandBarHeight": 60,
    "homeBarHeight": 46,
    "contentGutter": 32,
    "contentGutterNarrow": 24,
    "contentMaxWidthCap": 2880,
    "pageHeaderTitle": 24,
    "settingsNavWidth": 208,
    "settingsContentMax": 1500,
    "emptyStateMaxWidth": 520,
    "toastMaxWidth": 460,
    "navItemHeight": 40,
    "buttonHeight": 40,
    "buttonHeightHero": 44,
    "rowMinHeight": 56,
    "rowMaxHeight": 72,
    "iconBadge": 34
  },
  "breakpoints": {
    "metrics1to2": 380,
    "compactWrap": 420,
    "versionCompact": 460,
    "accountActiveLabel": 560,
    "pageHeaderStack": 600,
    "recent1to2": 620,
    "compactLaunch": 680,
    "wideRow": 720,
    "heroArt": 760,
    "settingsSidebar": 820,
    "queueDetails": 860,
    "accountCompact": 900,
    "instances1to2": 1020,
    "detailTwoColumn": 1040,
    "feed1to2": 1200,
    "accountsSplit": 1400,
    "instances2to3": 1500,
    "instances3to4": 1850,
    "feed2to3": 2100,
    "instances4to5": 2200,
    "shellCap": 2880
  },
  "icons": {
    "family": "outline",
    "grid": 24,
    "stroke": 2,
    "sizes": [16, 18, 20, 24],
    "rule": "One semantic name per meaning; pages reference the semantic registry, never raw icon constants."
  }
}
